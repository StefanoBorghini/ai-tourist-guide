# Variabili d'ambiente della guida. Copiare in .env.local (ignorato da git) e compilare.
# Mai mettere valori reali in questo file.

# Domande alla guida (solo server)
ANTHROPIC_API_KEY=
# Dollari massimi STIMATI per domanda (es. 0.15, con il punto). Obbligatoria: senza, domande spente.
# Non è un tetto assoluto: vedi docs/v0.3-platform/COSTI-AI.md. Il tetto rigido è nella Console Anthropic.
ASK_MAX_USD_PER_QUESTION=

# Account dei visitatori (docs/v0.3-platform/ACCOUNT.md). Entrano nel codice al build. Spenti senza tutte e quattro.
NEXT_PUBLIC_ACCOUNTS_ENABLED=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_LEGAL_VERSION=
# Accessi social attivi, solo dopo la configurazione in Supabase (es. google,apple).
NEXT_PUBLIC_AUTH_PROVIDERS=

# Supabase (Studio, bundle pubblicati, account)
NEXT_PUBLIC_SUPABASE_URL=https://<progetto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chiave-pubblica-anon>
# Solo server: ignora le policy RLS. Mai nel client, mai nei log. La usa solo il webhook di Stripe.
SUPABASE_SERVICE_ROLE_KEY=<chiave-di-servizio>

# Acquisti con Stripe, SOLO modalità test (docs/v0.3-platform/PAGAMENTI.md). Solo server. Spenti senza tutte e tre
# (con la chiave di servizio qui sopra) e con una chiave live (sk_live_…).
STRIPE_SECRET_KEY=sk_test_<…>
STRIPE_WEBHOOK_SECRET=whsec_<…>
