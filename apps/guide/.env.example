# Variabili d'ambiente della guida. Copiare in .env.local (ignorato da git) e compilare.
# Mai mettere valori reali in questo file.

# Domande alla guida (solo server). Fornitore di default: Anthropic.
ANTHROPIC_API_KEY=
# Per usare un altro fornitore con API compatibile OpenAI (Mistral, vLLM, servizi gestiti di modelli aperti):
# ASK_PROVIDER=openai-compatible
# ASK_BASE_URL=https://<servizio>/v1
# ASK_API_KEY=<chiave-del-servizio>
# ASK_MODEL=<nome-del-modello>
# (con questo fornitore la ricerca web è attiva solo se è impostata anche ANTHROPIC_API_KEY)
# Tetto di spesa giornaliero stimato per istanza del server, in dollari (default 10; 0 = nessun tetto).
# Il limite affidabile resta quello impostato nella console del fornitore.
# ASK_DAILY_BUDGET_USD=10
# Dollari massimi STIMATI per domanda (es. 0.15, con il punto). Obbligatoria: senza, domande spente.
# Non è un tetto assoluto: vedi docs/v0.3-platform/COSTI-AI.md. Il tetto rigido è nella Console Anthropic.
ASK_MAX_USD_PER_QUESTION=

# Account dei visitatori (docs/v0.3-platform/ACCOUNT.md). Entrano nel codice al build. Spenti senza tutte e quattro.
NEXT_PUBLIC_ACCOUNTS_ENABLED=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_LEGAL_VERSION=
# Accessi social attivi, solo dopo la configurazione in Supabase (es. google,apple).
NEXT_PUBLIC_AUTH_PROVIDERS=

# Supabase (Studio, bundle pubblicati, account)
NEXT_PUBLIC_SUPABASE_URL=https://<progetto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<chiave-pubblica-anon>
# Solo server: ignora le policy RLS. Mai nel client, mai nei log. La usano solo il webhook di Stripe (funzioni
# payment_*) e il registro delle domande senza risposta (solo gap_record).
SUPABASE_SERVICE_ROLE_KEY=<chiave-di-servizio>
# Registro delle domande senza risposta (docs/v0.3-platform/DOMANDE-SENZA-RISPOSTA.md). Spento senza «1». Prima di
# accenderlo per il pubblico: migrazione 20261103000000 applicata e informativa privacy aggiornata.
# QUESTION_GAPS_ENABLED=0

# Acquisti con Stripe, SOLO modalità test (docs/v0.3-platform/PAGAMENTI.md). Solo server. Spenti senza tutte e tre
# (con la chiave di servizio qui sopra) e con una chiave live (sk_live_…).
STRIPE_SECRET_KEY=sk_test_<…>
STRIPE_WEBHOOK_SECRET=whsec_<…>
